{
  "expo": {
    "name": "교대알람",
    "slug": "alarm-app",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "alarmapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f6fa"
    },
    "android": {
      "package": "com.danielpark.alarmapp",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground-new.png",
        "monochromeImage": "./assets/android-icon-monochrome-new.png",
        "backgroundColor": "#5D4FA4"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_EXACT_ALARM",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danielpark.alarmapp",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "CFBundleLocalizations": [
          "ko",
          "en",
          "ja",
          "zh-Hans",
          "zh-Hant",
          "es",
          "fr",
          "de",
          "pt"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "NSUserNotificationsUsageDescription": "알람을 울리기 위해 알림 권한이 필요합니다.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        },
        "CFBundleDisplayName": "RotaWake",
        "LSApplicationQueriesSchemes": [
          "mallo"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "교대알람은 사진 보관함을 사용하지 않습니다. 파일 저장에 쓰는 시스템 구성 요소 때문에 필요한 항목입니다."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.danielpark.shared"
        ]
      },
      "buildNumber": "2"
    },
    "plugins": [
      "expo-router",
      "./plugins/withoutPushEntitlement.js",
      [
        "expo-notifications",
        {
          "color": "#000000",
          "sounds": [
            "./assets/alarm_long.wav",
            "./assets/silent_short.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withIosMinDeploymentTarget.js",
      "./plugins/withIosSceneDelegate.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "ko": "./locales/ko.json"
    }
  }
}
