{
  "expo": {
    "name": "알람",
    "slug": "alarm-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "alarmapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f6fa"
    },
    "android": {
      "package": "com.danielpark.alarmapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f5f6fa"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_EXACT_ALARM",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.danielpark.alarmapp",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "NSUserNotificationsUsageDescription": "알람을 울리기 위해 알림 권한이 필요합니다."
      }
    },
    "plugins": [
      "expo-router",
      ["expo-notifications", {"color": "#000000", "sounds": ["./assets/alarm_long.wav"]}]
    ],
    "experiments": { "typedRoutes": true }
  }
}
