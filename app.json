{
  "expo": {
    "name": "교대알람",
    "slug": "alarm-app",
    "version": "1.6.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "alarmapp",
      "alarmappshare"
    ],
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f6fa"
    },
    "android": {
      "package": "com.danielpark.alarmapp",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground-new.png",
        "monochromeImage": "./assets/android-icon-monochrome-new.png",
        "backgroundColor": "#5D4FA4"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_EXACT_ALARM",
        "SCHEDULE_EXACT_ALARM"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "danielpark64.github.io",
              "pathPrefix": "/alarm-ios/s"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danielpark.alarmapp",
      "appleTeamId": "T5Z6ACK2PU",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "CFBundleLocalizations": [
          "ko",
          "en",
          "ja",
          "zh-Hans",
          "zh-Hant",
          "es",
          "fr",
          "de",
          "pt"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "NSUserNotificationsUsageDescription": "알람을 울리기 위해 알림 권한이 필요합니다.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        },
        "CFBundleDisplayName": "RotaWake",
        "LSApplicationQueriesSchemes": [
          "mallo"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "교대알람은 사진 보관함을 사용하지 않습니다. 파일 저장에 쓰는 시스템 구성 요소 때문에 필요한 항목입니다.",
        "NSAlarmKitUsageDescription": "무음·집중 모드에서도 시계 앱 알람처럼 전체 화면으로 울리게 하려면 알람 권한이 필요합니다.",
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.danielpark.shared"
        ],
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "buildNumber": "16",
      "associatedDomains": [
        "applinks:danielpark64.github.io"
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/withoutPushEntitlement.js",
      [
        "expo-notifications",
        {
          "color": "#000000",
          "sounds": [
            "./assets/alarm_long.wav",
            "./assets/silent_short.wav",
            "./assets/sounds/tone_beep.caf",
            "./assets/sounds/tone_chime.caf",
            "./assets/sounds/tone_oldclock.caf",
            "./assets/sounds/tone_marimba.caf",
            "./assets/sounds/tone_piano.caf",
            "./assets/sounds/tone_musicbox.caf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withIosMinDeploymentTarget.js",
      "./plugins/withIosSceneDelegate.js",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json",
      "ja": "./locales/ja.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "zh-Hant": "./locales/zh-Hant.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "pt": "./locales/pt.json"
    }
  }
}
