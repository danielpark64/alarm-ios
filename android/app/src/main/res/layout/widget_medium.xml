<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <!-- 왼쪽: 알람 시간 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_alarm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰ 다음 알람"
            android:textColor="#aaaacc"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_alarm_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#f0f0ff"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 세로 구분선 -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#33ffffff"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp" />

    <!-- 오른쪽: 근무조 + 비번 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_shift_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="10sp"
                android:textColor="#a29bfe"
                android:layout_marginEnd="3dp" />

            <TextView
                android:id="@+id/widget_shift_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#c8c8e0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/widget_off_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴"
                android:textSize="8sp"
                android:layout_marginEnd="2dp" />

            <TextView
                android:id="@+id/widget_off_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="비번 --일"
                android:textColor="#f06565"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
